# ---- Required in production ----
# Postgres connection string (Neon free tier works well: https://neon.tech)
DATABASE_URL=postgres://user:password@host/db?sslmode=require
# Long random string used to sign login sessions (e.g. `openssl rand -hex 32`)
SESSION_SECRET=
# Coach dashboard login (created/updated automatically on start)
ADMIN_EMAIL=coach@example.com
ADMIN_PASSWORD=
# The public address of the site, used for Stripe return links
SITE_URL=https://your-app.vercel.app

# ---- Optional: real Stripe Checkout (use TEST keys for the demo) ----
# Leave empty to use the built-in preview checkout (nothing is charged).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
